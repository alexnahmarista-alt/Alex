PORT=3000
NODE_ENV=production

# Clave secreta para firmar los tokens de sesión (JWT).
# Genera una aleatoria y larga antes de desplegar, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES_IN=12h

# Usuario administrador que se crea automáticamente la primera vez que arranca el servidor
# (solo si la tabla de usuarios está vacía). Cámbialo después desde la app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esta_password
ADMIN_NAME=Administrador

# Prefijo del folio de venta (ej. CFF-0001, CFF-0002, ...)
FOLIO_PREFIX=CFF

# Origen permitido para CORS. En producción usa el dominio real del frontend,
# por ejemplo: https://ventas.tudominio.com  (deja * solo para pruebas locales)
CORS_ORIGIN=*
